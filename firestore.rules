rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isIncharge() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'incharge'
      );
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      // User can read their own profile, or in-charge can read/list all users
      // Also allow user to read/create their own document during initial signup/login bootstrap
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isIncharge());
      allow update: if isSignedIn() && (request.auth.uid == userId || isIncharge());
      allow delete: if isIncharge();
    }

    // Students collection
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Drives collection
    match /drives/{driveId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Clearances collection
    match /clearances/{clearanceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
