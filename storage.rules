rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isIncharge() {
      return isSignedIn() && userProfile().role == 'incharge' && userProfile().active != false;
    }

    function isStudentOwner(applicationId) {
      let profile = userProfile();
      let application = firestore.get(
        /databases/(default)/documents/applications/$(applicationId)
      ).data;
      return profile.role == 'student' &&
        profile.active != false &&
        application.studentId == profile.studentId;
    }

    match /offer-letters/{applicationId}/{fileName} {
      allow read: if isIncharge() || (isSignedIn() && isStudentOwner(applicationId));
      allow write: if isIncharge() &&
        request.resource != null &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
    }
  }
}
